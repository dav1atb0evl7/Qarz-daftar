# ==========================================
# QARZ DAFTAR PRO - Environment Variables
# ==========================================

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-strong-secret-key-in-production-min50chars
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database (PostgreSQL)
# Use either full DATABASE_URL or individual variables
DATABASE_URL=postgresql://qarz_user:qarz_password@localhost:5432/qarz_daftar_db
DB_NAME=qarz_daftar_db
DB_USER=qarz_user
DB_PASSWORD=qarz_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Settings (in minutes / days)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@qarzdaftar.uz
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Qarz Daftar Pro <noreply@qarzdaftar.uz>

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_API_SECRET=super-secret-telegram-webhook-or-api-key-here
TELEGRAM_BOT_USERNAME=qarzdaftar_bot
